# Connessione PostgreSQL (su Railway: riferimento a ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@host:5432/bagalendario?schema=public"

# Segreto per firmare i JWT (stringa lunga e casuale)
JWT_SECRET="cambia-questo-valore"

# Origine consentita per CORS: URL del sito Netlify (più URL separati da virgola)
CORS_ORIGIN="https://bagalendario.netlify.app"

# Porta HTTP (Railway la imposta automaticamente)
PORT=3000

# URL pubblico del backend, usato per generare i link dei feed iCal
PUBLIC_API_URL="https://bagalendario-backend.up.railway.app"

# Utente ADMIN creato dal seed al primo avvio (se non esiste già)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-questa-password"
ADMIN_NOME="Amministratore"
