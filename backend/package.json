{
  "name": "bagalendario-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "predeploy": "prisma migrate deploy && node dist/seed.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ical-generator": "^11.1.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "prisma": "~6.19.3",
    "zod": "^4.6.5"
  }
